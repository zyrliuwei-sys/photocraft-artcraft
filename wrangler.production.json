{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photocraft-artcraft-ai",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://photocraftartcraft.com",
    "VITE_APP_NAME": "PhotoCraft ArtCraft AI",
    "VITE_APP_DESCRIPTION": "Download PhotoCraft, the free open-source Photoshop alternative from ArtCraft, rebuilt in Rust. Install guides, PhotoCraft vs Photoshop comparison and hands-on review.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photocraft-artcraft-ai",
      "database_id": "460502d3-219f-41c3-ada5-a4cdb3942f23",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    { "pattern": "photocraftartcraft.com", "custom_domain": true },
    { "pattern": "www.photocraftartcraft.com", "custom_domain": true }
  ]
}
