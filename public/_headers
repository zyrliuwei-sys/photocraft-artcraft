# Cloudflare static-asset headers for the PhotoCraft web editor (public/editor).
/editor/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/editor/*.js
  Cache-Control: public, max-age=31536000, immutable

/editor/
  Cache-Control: no-cache

/editor/index.html
  Cache-Control: no-cache
